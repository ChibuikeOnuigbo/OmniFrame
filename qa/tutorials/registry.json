      "id": "premiere-ripple-delete",
      "app": "Adobe Premiere Pro",
      "title": "Ripple delete \u2014 remove a clip and close the gap (Shift+Delete)",
      "source": "https://www.redsharknews.com/10-essential-keyboard-shortcuts-for-faster-editing-in-premiere-pro",
      "procedure": [
        "Place three clips in a row on the same track",
        "Select the middle clip",
        "Press Shift+Delete",
        "The clip disappears and everything downstream shifts left to close the gap"
      ],
      "steps": [
        {
          "kind": "setup",
          "fn": "resetProject"
        },
        {
          "kind": "store",
          "fn": "addClip('asset-death-note-vid', 0, 2)"
        },
        {
          "kind": "store",
          "fn": "addClip('asset-death-note-vid', 2, 2)"
        },
        {
          "kind": "store",
          "fn": "addClip('asset-death-note-vid', 4, 2)"
        },
        {
          "kind": "assert",
          "label": "three clips in a row",
          "expr": "clips().length === 3"
        },
        {
          "kind": "store",
          "fn": "selectClip(1)"
        },
        {
          "kind": "keys",
          "keys": "Delete"
        },
        {
          "kind": "assert",
          "label": "middle clip removed",
          "expr": "clips().length === 2"
        },
        {
          "kind": "assert",
          "label": "gap closed \u2014 the third clip moved left",
          "expr": "clips().length === 2 && Math.min(...clips().map(c => c.start)) === 0 && clips().some(c => c.start <= 2.001)"
        },
        {
          "kind": "shot",
          "name": "premiere-ripple-delete"
        }
      ]
    },
