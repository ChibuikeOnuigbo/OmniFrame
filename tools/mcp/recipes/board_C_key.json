  },
  {
   "tool": "select",
   "params": {
    "clipId": "clip-2"
   }
  },
  {
   "tool": "track_new",
   "params": {
    "name": "keyed char"
   }
  },
  {
   "tool": "transparent_select",
   "params": {
    "ignore": "#000000",
    "ignoreTol": 40,
    "target": "light"
   }
  },
  {
   "tool": "omniframe_extract",
   "params": {
    "trackId": 1
   }
  },
  {
   "tool": "patch_under",
   "params": {
    "on": true,
    "feather": 2
   }
  },
  {
   "tool": "transform_set",
   "params": {
    "scale": "{{sc}}"
   }
  },
  {
   "tool": "keyframe_set",
   "params": {
    "property": "position",
    "channel": "X",
    "time": 0,
    "value": "{{startX}}",
    "interpolation": "{{interp}}"
   }
  },
  {
   "tool": "keyframe_set",
   "params": {
    "property": "position",
    "channel": "X",
    "time": 0.9,
    "value": "{{endX}}",
    "interpolation": "{{interp}}"
   }
  },
  {
   "tool": "curve_set",
   "params": {
    "property": "position",
    "channel": "X",
    "interpolation": "{{interp}}"
   }
  },
  {
   "tool": "effect_set",
   "params": {
    "patch": {
     "chromatic": "{{cc}}",
     "lightType": "point",
     "lightIntensity": "{{li}}",
     "lightColor": "#ffd9a0"
    }
   }
  },
  {
   "tool": "snapshot",
   "params": {
    "time": 1.7,
    "out": "test_ans_result/C_composition/snap-{{vi}}.png"
   }
  },
  {
   "tool": "render_export",
   "params": {
    "out": "test_ans_result/C_composition/variant-{{vi}}.mp4"
   }
  },
  {
   "tool": "timeline_screenshot",
   "params": {
    "out": "test_ans_result/evidence/timeline-C-{{vi}}.png",
    "playhead": 1.7
   }
  }
