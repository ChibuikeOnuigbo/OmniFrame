{
 "name": "board_J_effects",
 "description": "CapCut-style effect system (board J): effects dropped ONTO clips as inner instances (full clip length by default, closed container, per-property keyframes), range-limited instances, and standalone effect clips that grade every track below. Glitch moved OUT of transitions into effects — its intensity is keyframed here.",
 "steps": [
  { "tool": "project_new", "params": { "w": 640, "h": 360, "fps": 24, "duration": 3, "bg": "#101014" } },
  { "tool": "import_media", "params": { "path": "qa/shots/01-home.png", "fit": "contain", "scale": 0.62 } },
  { "tool": "fx_add", "params": { "clipId": "clip-1", "catalogId": "{{fxid}}", "inP": "{{inP}}", "duration": "{{dur}}", "keyParam": "{{keyParam}}", "keyFrom": "{{keyFrom}}", "keyTo": "{{keyTo}}", "asLayer": "{{layer}}" } },
  { "tool": "render_export", "params": { "out": "{{out}}", "fps": 24 } },
  { "tool": "inspect", "params": {} }
 ],
 "variants": [
  { "name": "glitch-keys", "overrides": { "fxid": "glitch-rgb-heavy", "inP": 0, "dur": 3, "keyParam": "glitch", "keyFrom": 0.04, "keyTo": 1, "layer": 0, "out": "test_ans_result/J_effects/fx-glitch-keyframed.mp4" } },
  { "name": "ranged-vhs", "overrides": { "fxid": "vhs-3", "inP": 1.5, "dur": 1.5, "keyParam": "", "keyFrom": 0, "keyTo": 0, "layer": 0, "out": "test_ans_result/J_effects/fx-ranged-vhs.mp4" } },
  { "name": "layer-noir", "overrides": { "fxid": "look-noir", "inP": 0, "dur": 3, "keyParam": "", "keyFrom": 0, "keyTo": 0, "layer": 1, "out": "test_ans_result/J_effects/fx-layer-noir.mp4" } }
 ]
}
