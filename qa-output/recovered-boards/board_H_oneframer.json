{
  "name": "board_H_oneframer",
  "description": "AE one-framer family from MatttVfx j3Lt0dU1Lok: directional minimax smear + VHS aesthetic + directional colorize as universal pixelGrade keys; variants isolate each look.",
  "steps": [
    {
      "tool": "project_new",
      "params": {
        "w": 640,
        "h": 360,
        "fps": 24,
        "duration": 2,
        "bg": "#101014"
      }
    },
    {
      "tool": "new_background",
      "params": {
        "kind": "sunset"
      }
    },
    {
      "tool": "select",
      "params": {
        "clipId": "clip-1"
      }
    },
    {
      "tool": "effect_set",
      "params": {
        "patch": {
          "minimax": "{{mm}}",
          "minimaxAngle": 30,
          "vhs": "{{vv}}",
          "dirColorize": "{{dc}}",
          "dirColorizeFrom": "#0028ff",
          "dirColorizeTo": "#ff2800",
          "dirColorizeAngle": 45
        }
      }
    },
    {
      "tool": "render_export",
      "params": {
        "out": "{{out}}",
        "fps": 24
      }
    },
    {
      "tool": "inspect",
      "params": {}
    }
  ],
  "variants": [
    {
      "name": "all",
      "overrides": {
        "mm": 0.6,
        "vv": 0.55,
        "dc": 0.45,
        "out": "qa-output/recovered-boards/H_oneframer/oneframer-all.mp4"
      }
    },
    {
      "name": "vhs",
      "overrides": {
        "mm": 0,
        "vv": 0.7,
        "dc": 0,
        "out": "qa-output/recovered-boards/H_oneframer/oneframer-vhs.mp4"
      }
    },
    {
      "name": "minicolor",
      "overrides": {
        "mm": 0.7,
        "vv": 0,
        "dc": 0.6,
        "out": "qa-output/recovered-boards/H_oneframer/oneframer-minimax-colorize.mp4"
      }
    }
  ]
}